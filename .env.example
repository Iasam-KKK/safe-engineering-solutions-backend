# Copy to .env (next to manage.py) and fill in. Never commit .env.

# --- laptop ---
DJANGO_DEBUG=true
FRONTEND_URL=http://localhost:3000
# Same value as REVALIDATE_SECRET in frontend/.env.local, so admin saves refresh the site
REVALIDATE_SECRET=

# --- live server (set these instead of DJANGO_DEBUG=true) ---
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_ALLOWED_HOSTS=api.safeengineering.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.safeengineering.example
# DATABASE_URL=postgres://user:password@host:5432/safe
# CORS_ALLOWED_ORIGINS=https://safeengineering.example
# FRONTEND_URL=https://safeengineering.example
# PUBLIC_MEDIA_BASE=https://api.safeengineering.example
# RELATIVE_MEDIA_URLS=true       # media as /media/...: the Next.js site forwards it (one address, e.g. a Tailscale link)
# SERVE_MEDIA=true                 # only if no web server / bucket serves /media/
# MEDIA_ROOT=/var/safe/media
# PRIVATE_MEDIA_ROOT=/var/safe/private_media
# DRF_NUM_PROXIES=1                # behind nginx or a load balancer

# --- email alerts for new requests ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=SAFE website <no-reply@safeengineering.example>
# INQUIRY_NOTIFY_EMAILS=saifulhaq_kkk@yahoo.com

# --- Google Drive sync (manage.py sync_drive) ---
# GOOGLE_SERVICE_ACCOUNT_FILE=/srv/safe/drive-sync-key.json
# DRIVE_FOLDER_ID=1dBUu5n3b8lMnDUz2vbuxwhvtdQSgxMW5
# DRIVE_MIRROR_DIR=/srv/safe/drive_mirror
# IMPORT_NOTIFY_EMAILS=saifulhaq_kkk@yahoo.com
